# ──────────────────────────────────────────────
# Quai Network – Deployment Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# Private key of the deployer wallet (MetaMask / Pelagus)
# NEVER commit the real .env file to version control
DEPLOYER_PRIVATE_KEY=

# Quai Testnet (Colosseum – Cyprus-1)
QUAI_TESTNET_RPC=https://rpc.cyprus1.colosseum.quaiscan.io
QUAI_TESTNET_CHAIN_ID=9000

# Quai Mainnet (Golden Age – Cyprus-1)
QUAI_MAINNET_RPC=https://rpc.cyprus1.quaiscan.io
QUAI_MAINNET_CHAIN_ID=9000
